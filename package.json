{
  "name": "pumpfun-paper-bot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "bot": "tsx apps/bot/src/main.ts",
    "analyst": "tsx apps/analyst/src/main.ts",
    "replay": "tsx apps/bot/src/replay.ts",
    "signal": "tsx apps/bot/src/signalCli.ts",
    "probe": "tsx apps/bot/src/probe.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "idl:refresh": "node -e \"require('fs').copyFileSync('node_modules/@pump-fun/pump-sdk/src/idl/pump.json','packages/core/idl/pump.json')\"",
    "retro": "tsx apps/analyst/src/retroCli.ts",
    "dashboard:build": "npm --workspace @pf/dashboard run build",
    "up": "npm run dashboard:build && pm2 start ecosystem.config.cjs && pm2 save",
    "down": "pm2 stop ecosystem.config.cjs",
    "status": "pm2 status",
    "logs": "pm2 logs --lines 50",
    "dashboard": "npm --workspace @pf/dashboard run dev",
    "debate": "tsx scripts/debate.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "pm2": "^7.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
